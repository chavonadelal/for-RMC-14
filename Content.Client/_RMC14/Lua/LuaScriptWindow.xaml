<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:ui="clr-namespace:Content.Client._RMC14.UserInterface"
                      xmlns:graphics="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      Title="ARES Lua Console"
                      MinSize="480 460"
                      SetSize="520 480">
    <BoxContainer Orientation="Vertical"
                   HorizontalExpand="True"
                   VerticalExpand="True"
                   Margin="10 8 10 10"
                   SeparationOverride="0">

        <!-- Code section: distinct panel with border and background -->
        <BoxContainer Orientation="Vertical" Margin="0 0 0 8">
            <Label Text="Code"
                   StyleClasses="LabelHeading"
                   Margin="0 0 0 4" />
            <PanelContainer MinHeight="140"
                            HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#252525"
                                            BorderColor="#3A3A3A"
                                            BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <TextEdit Name="CodeInput"
                          Access="Public"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          Margin="6" />
            </PanelContainer>
        </BoxContainer>

        <Button Name="RunButton"
                Access="Public"
                Text="Run"
                HorizontalAlignment="Right"
                StyleClasses="OpenBoth"
                MinWidth="80"
                Margin="0 4 0 8" />

        <ui:BlueHorizontalSeparator Margin="0 0 0 8" />

        <!-- Output section: separate panel, slightly darker to differentiate -->
        <BoxContainer Orientation="Vertical"
                      VerticalExpand="True">
            <Label Text="Output"
                   StyleClasses="LabelHeading"
                   Margin="0 0 0 4" />
            <PanelContainer MinHeight="140"
                            HorizontalExpand="True"
                            VerticalExpand="True">
                <PanelContainer.PanelOverride>
                    <graphics:StyleBoxFlat BackgroundColor="#1A1A1A"
                                            BorderColor="#3A3A3A"
                                            BorderThickness="1" />
                </PanelContainer.PanelOverride>
                <TextEdit Name="OutputDisplay"
                          Access="Public"
                          HorizontalExpand="True"
                          VerticalExpand="True"
                          Margin="6" />
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
